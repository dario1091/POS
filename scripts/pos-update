#!/bin/bash
# pos-update: Actualiza POS System desde GitHub Releases
# Instalar: sudo cp pos-update /usr/local/bin/ && sudo chmod +x /usr/local/bin/pos-update

REPO="dario1091/POS"  # GitHub repo

echo "🔄 Buscando última versión de POS System..."

# Get latest release download URL
LATEST_URL=$(curl -s "https://api.github.com/repos/$REPO/releases/latest" \
  | grep "browser_download_url.*\.deb" \
  | cut -d '"' -f 4)

if [ -z "$LATEST_URL" ]; then
  echo "❌ No se encontró ninguna release. Verifica el repo: $REPO"
  exit 1
fi

FILENAME=$(basename "$LATEST_URL")
echo "📦 Descargando: $FILENAME"

# Download
wget -q --show-progress -O "/tmp/$FILENAME" "$LATEST_URL"

if [ $? -ne 0 ]; then
  echo "❌ Error descargando. ¿Hay conexión a internet?"
  exit 1
fi

# Install
echo "📥 Instalando..."
sudo dpkg -i "/tmp/$FILENAME"

if [ $? -eq 0 ]; then
  echo "✅ POS System actualizado correctamente."
  echo "   Reinicia la aplicación para usar la nueva versión."
  rm "/tmp/$FILENAME"
else
  echo "❌ Error en la instalación."
  exit 1
fi
